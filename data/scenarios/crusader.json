  "replacements": [
    {"date": "1941-11-27", "unit": 311, "tanks": 33, "src": "N", "note": "Tanks from the reserve and the workshops.", "basis": "the difference between 37 tanks on the night of 24 November and 70 on the 27th; the source does not say how many were new and how many repaired"},
    {"date": "1941-12-06", "unit": 311, "tanks": 38, "src": "N", "note": "Tanks from the reserve and the workshops.", "basis": "the difference between 98 tanks on 4 December and 136 on the 6th; the source says only that equipment was renewed"},
    {"date": "1941-12-22", "unit": 313, "tanks": 60, "src": "J", "note": "Re-equipped with fresh Crusaders and Stuarts.", "basis": "110 tanks by 22 December against fewer than 50 on 27 November (N); its strength just before it was re-equipped was not found, so 60 is the least it can have been"},
    {"date": "1941-12-19", "unit": 111, "tanks": 22, "via": "Benghazi", "src": "R", "note": "Landed at Benghazi from the Ankara.", "basis": "the date is the landing; that the tanks joined the regiment within the two days of the turn is assumed"},
    {"date": "1941-12-27", "unit": 111, "tanks": 23, "src": "R", "note": "Landed at Tripoli on 19 December and brought up the coast road.", "basis": "the landing is dated; the day the tanks reached the regiment was not found. The Afrika Korps attacked with 70 tanks on 28 December (N), so they are taken to have joined by the 27th"}
  ],
